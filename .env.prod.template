# Production Environment Variables Template
# Copy this file to .env and fill in the actual values

# Database Configuration (Production)
DB_USERNAME=prod_db_user
DB_PASSWORD=strong_prod_password_here

# JWT Configuration (Generate with: openssl rand -hex 32)
JWT_SECRET=your-production-jwt-secret-key-min-32-chars

# SendPulse REST API Configuration
# Create app at: https://login.sendpulse.com/oauth/applications
SENDPULSE_CLIENT_ID=your_client_id_here
SENDPULSE_CLIENT_SECRET=your_client_secret_here
SENDPULSE_MAIL_FROM_EMAIL=noreply@yourdomain.com
SENDPULSE_MAIL_FROM_NAME=Go Cinema

# AWS S3 Configuration
AWS_ACCESS_KEY=your_aws_access_key_id
AWS_SECRET_KEY=your_aws_secret_access_key

# PayOS Configuration
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# OpenAI Configuration (for Chatbot)
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini

# Spring AI OpenAI (if different from above)
SPRING_AI_OPENAI_API_KEY=${OPENAI_API_KEY}

# Frontend Configuration
FRONTEND_HOST=https://gocinema.io.vn
FRONTEND_PORT=

# Backend Configuration
BACKEND_HOST=https://api.gocinema.io.vn
BACKEND_PORT=

# VNPay IP Configuration
# Set to your server public IP address
VNP_IP_ADDRESS=your_server_public_ip
