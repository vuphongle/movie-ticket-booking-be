# Production Environment Variables Template
# Copy this file to .env.prod on your Digital Ocean server

# DigitalOcean Container Registry
DO_REGISTRY_NAME=your-registry-name

# DigitalOcean Access Token (for docker login)
DIGITALOCEAN_ACCESS_TOKEN=your-digitalocean-access-token

# Database Configuration
DB_ROOT_PASSWORD=your-secure-root-password
DB_NAME=db-movie-ticket-booking
DB_USERNAME=movie_user
DB_PASSWORD=your-secure-db-password

# JWT Configuration
JWT_SECRET=your-very-long-and-secure-jwt-secret-key-at-least-256-bits

# Email Configuration
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# Frontend Configuration
FRONTEND_HOST=https://your-frontend-domain.com
FRONTEND_PORT=443

# Server Configuration
SERVER_PORT=8080

# SSL Configuration (if using)
SSL_CERT_PATH=/opt/movie-booking/ssl/cert.pem
SSL_KEY_PATH=/opt/movie-booking/ssl/key.pem
