# Environment variables cho Docker development
# Copy file này thành .env và điền thông tin thực tế

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=db-movie-ticket-booking
DB_USERNAME=movie_user
DB_PASSWORD=secure_password_change_me
DB_ROOT_PASSWORD=root_password_change_me

# Application Configuration
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080

# JWT Security
JWT_SECRET=your_very_long_jwt_secret_key_here_minimum_256_bits

# Email Configuration (Gmail)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Frontend Configuration
FRONTEND_HOST=http://localhost
FRONTEND_PORT=3000

# Optional: For production with Nginx
# DOMAIN_NAME=yourdomain.com
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
